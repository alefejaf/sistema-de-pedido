# Modelo de variaveis de ambiente para a implantacao Docker no TrueNAS SCALE.
#
# IMPORTANTE: os segredos de login (Google Service Account, sheet_id, conta
# master) NAO vem por variavel de ambiente neste app - o Streamlit le tudo de
# st.secrets, que precisa vir de um arquivo .streamlit/secrets.toml montado
# como volume/bind mount no container (veja DEPLOY_TRUENAS.md). Preencha esse
# arquivo a partir do modelo .streamlit/secrets.toml.example.
#
# As variaveis abaixo sao opcionais e config do proprio Streamlit (nao do
# codigo do app) - use se quiser ajustar via docker-compose em vez de flags
# de linha de comando. Copie este arquivo para .env e ajuste se necessario;
# .env nunca deve ser commitado (ja esta no .gitignore).

# Fuso horario do container (usado nos timestamps de log/backup).
TZ=America/Sao_Paulo

# Configuracoes nativas do Streamlit via env var (opcional - os mesmos
# valores ja sao passados como flag no ENTRYPOINT do Dockerfile).
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
